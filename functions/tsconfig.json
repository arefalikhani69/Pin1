{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "es2022",
    "outDir": "lib",
    "rootDir": "src",
    "strict": false,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
